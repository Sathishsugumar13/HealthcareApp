{
  "expo": {
    "name": "HealthcareApp",
    "slug": "HealthcareApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/common/new-app-icon.jpg",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./src/assets/images/common/new-app-icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sathishsugumar.healthcareapp",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/common/new-app-icon.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./src/assets/expo/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "27238de2-cd8c-445f-ad5c-db22da1d219a"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you set a profile picture.",
          "cameraPermission": "The app accesses your camera to let you take a profile picture."
        }
      ],
      "expo-font"
    ],
    "owner": "sathishsugumar"
  }
}
